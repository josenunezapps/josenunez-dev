/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Página principal: las demos de los teléfonos se cargan desde GitHub Pages (y el Escáner usa la cámara)
/
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://josenunezapps.github.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://josenunezapps.github.io"), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

/index.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-src https://josenunezapps.github.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://josenunezapps.github.io"), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

/servicios.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/sobre-mi.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/contacto.html
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests

/api/*
  Cache-Control: no-store
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# La demo debe recuperar su última versión en cada visita.
/norte-aberturas-app-6p2d/*
  Cache-Control: no-store, max-age=0, must-revalidate

# Versión nueva en prueba: no indexar, y permitir la cámara solo a las demos de Zenix (Escáner)
/zenix-next/*
  ! Permissions-Policy
  Permissions-Policy: camera=(self "https://josenunezapps.github.io"), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache
